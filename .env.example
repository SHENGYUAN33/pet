# Ollama (local LLM for script generation)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Coqui XTTS-v2 (local TTS for narration)
XTTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
TTS_LANGUAGE=zh-cn

# PostgreSQL (pet catalog + generation job history). Defaults here are for
# local dev only via docker-compose.yml — never reuse these credentials
# anywhere shared/production.
POSTGRES_USER=petvideo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=petvideo
DATABASE_URL=postgresql+psycopg://petvideo:changeme@localhost:5433/petvideo
# Seconds to wait for a database connection before giving up. Without it
# libpq waits indefinitely, so a stopped PostgreSQL makes `pytest` stall for
# many minutes instead of skipping its database-backed tests. Raise it only
# if DATABASE_URL points somewhere genuinely slow to reach.
DB_CONNECT_TIMEOUT=2

# Subtitle burn-in font for FFmpeg drawtext. An explicit fontfile avoids
# relying on fontconfig, which is usually unconfigured on Windows.
DRAWTEXT_FONT_FILE=C:\Windows\Fonts\msjh.ttc

# Shot-level generation targets (docs/architecture.md §2): 5-7 shots of 3-6s
# each. Centralized here rather than hardcoded in the prompt / QA validator.
MIN_SCENES=5
MAX_SCENES=7
MIN_SCENE_DURATION=3
MAX_SCENE_DURATION=6

# Image-to-Video (open-source, self-hosted, requires a CUDA GPU)
# --- diffusers-based providers (pip install -e ".[i2v]") ---
SVD_MODEL_NAME=stabilityai/stable-video-diffusion-img2vid-xt
COGVIDEOX_MODEL_NAME=THUDM/CogVideoX-5b-I2V
COGVIDEOX_DEFAULT_PROMPT=The subject moves naturally and subtly.

# --- Wan2.2 TI2V-5B, via a locally-running ComfyUI server (vendor/comfyui/,
# its own venv, started separately — see STARTUP.md). Model file paths are
# relative to ComfyUI's own models/diffusion_models, models/vae and
# models/text_encoders directories. ---
WAN_COMFYUI_URL=http://127.0.0.1:8188
WAN_MODEL_FILE=WanVideo\2_2\TI2V\Wan2_2-TI2V-5B_fp8_e4m3fn_scaled_KJ.safetensors
WAN_VAE_FILE=wanvideo\Wan2_2_VAE_bf16.safetensors
WAN_T5_FILE=umt5-xxl-enc-fp8_e4m3fn.safetensors
WAN_SAMPLE_STEPS=20
WAN_WIDTH=704
WAN_HEIGHT=1280
WAN_FPS=24
WAN_DEFAULT_PROMPT=The subject moves naturally and subtly.
# Turning down the motion when a result comes out swimming/warping:
#   WAN_SHIFT   how far the sampler travels from the source frame. Lower =
#               steadier and closer to the original photo, but subtler motion.
#   WAN_CFG     how hard the prompts (both of them) are enforced.
#   WAN_SEED    fixed so a re-run reproduces the same take; change it to draw
#               a different one from the same photo.
WAN_CFG=5.0
WAN_SHIFT=5.0
WAN_SEED=47
# Appended to every prompt so callers don't have to know to ask for a locked
# camera. Set empty to opt out.
# WAN_PROMPT_SUFFIX= Static locked-off camera, fixed framing, no camera movement, no zoom, no pan.
# WAN_NEGATIVE_PROMPT also exists (long zh-CN default in pipeline/config.py);
# only set it here if you actually need to override that default.
