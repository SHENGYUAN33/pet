# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
build/
.next/
.turbo/

# Env / secrets
.env
.env.*
!.env.example

# Media / generated assets (large binary artifacts + real pet/contact data, keep out of git)
*.mp4
*.mov
*.wav
*.mp3
storage/profiles/*
!storage/profiles/.gitkeep
storage/assets/*
!storage/assets/.gitkeep
storage/output/*
!storage/output/.gitkeep
# Sticker shapes, drawn on demand by pipeline/stickers.py and cached here.
# Generated art, tinted per video — regenerating costs milliseconds, and the
# point of drawing them was to keep binaries out of version control.
storage/decor/*
!storage/decor/.gitkeep
tmp/

# Claude Code local overrides
.claude/settings.local.json

# Wan2.2 official inference repo (cloned, not vendored in git — has its own
# isolated venv + downloaded checkpoint, see providers/video/wan_provider.py)
vendor/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
